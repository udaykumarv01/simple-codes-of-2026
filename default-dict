from collections import defaultdict 
class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        if len(s) != len(t) :
            return False
        result = True
        freq = defaultdict(int)
        
        for x in s :
            freq[x] += 1
        for n in t :
            if x not in freq :
                return False 
            freq[n]-=1
            if freq[n] <0 :
                return False
        return True  
